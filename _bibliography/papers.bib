  video	    = {https://slideslive.com/38948683/asking-the-right-questions-learning-interpretable-action-models-through-query-answering},
  arxiv     = {1912.12613},
  oldn1      = {{Asking the Right Questions: Active Action-Model Learning}},
  olda1      = {Pulkit Verma, Shashank Rao Marpally, and Siddharth Srivastava},
