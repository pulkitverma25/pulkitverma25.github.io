<div class="media-coverage">
  {% if site.data.media != blank %}
    {% assign media_items = site.data.media | sort: "date" | reverse %}
    <div class="row">
      {% for item in media_items %}
        <div class="col-sm-6 col-lg-4 mb-4 d-flex align-items-stretch">
          <a
            href="{{ item.url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="w-100 text-decoration-none"
          >
            <div class="card h-100 hoverable media-card">
              {% if item.image %}
                <img class="card-img-top media-card-img" src="{{ item.image }}" alt="{{ item.title }}" loading="lazy" />
              {% endif %}
              <div class="card-body d-flex flex-column">
                <div class="mb-2">
                  {% case item.type %}
                    {% when "video" %}
                      <span class="badge media-badge"><i class="fa-brands fa-youtube"></i>&nbsp; YouTube Video</span>
                    {% when "short" %}
                      <span class="badge media-badge"><i class="fa-brands fa-youtube"></i>&nbsp; YouTube Short</span>
                    {% when "linkedin" %}
                      <span class="badge media-badge"><i class="fa-brands fa-linkedin"></i>&nbsp; LinkedIn Post</span>
                    {% else %}
                      <span class="badge media-badge"><i class="fa-solid fa-newspaper"></i>&nbsp; Press</span>
                  {% endcase %}
                </div>
                <h2 class="card-title h5">{{ item.title }}</h2>
                {% if item.description %}
                  <p class="card-text media-card-text">{{ item.description }}</p>
                {% endif %}
                <div class="mt-auto pt-2 media-card-meta">
                  {% if item.source %}{{ item.source }}{% endif %}
                  {% if item.date %}&nbsp;&middot;&nbsp;{{ item.date | date: "%b %-d, %Y" }}{% endif %}
                </div>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No media coverage yet...</p>
  {% endif %}
</div>
