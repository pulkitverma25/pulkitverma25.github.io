<div class="media-coverage">
  {% if site.data.media != blank %}
    {% assign all_items = site.data.media | sort: "date" | reverse %}
    {% assign talk_items = all_items | where: "type", "video" %}
    {% assign coverage_items = all_items | where_exp: "item", "item.type != 'video'" %}

    {% if coverage_items != blank %}
      <div class="row">
        {% for item in coverage_items %}
          {% include media_card.liquid item=item %}
        {% endfor %}
      </div>
    {% endif %}

    {% if talk_items != blank %}
      <h3 class="mt-3 mb-3">Talks</h3>
      <div class="row">
        {% for item in talk_items %}
          {% include media_card.liquid item=item %}
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <p>No media coverage yet...</p>
  {% endif %}
</div>
